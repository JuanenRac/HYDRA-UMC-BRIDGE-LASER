# The bridge only reads three GPIO lines and the status of the controller; it never arms or fires a laser.
# The configuration is /etc/hydra-umc/bridge-laser.toml (example: deploy/bridge-laser.example.toml); the MQTT
# credentials go in /etc/hydra-umc/bridge-laser.env (HYDRA_MQTT_USERNAME=..., readable by root only).
[Unit]
Description=HYDRA-UMC-BRIDGE-LASER laser cell safeguards and job gate
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hydra-umc-bridge-laser
Group=hydra-umc-bridge-laser
SupplementaryGroups=gpio dialout
WorkingDirectory=/opt/hydra-umc/bridge-laser
Environment=PYTHONPATH=/opt/hydra-umc/bridge-laser/src
Environment=HYDRA_UMC_BRIDGE_LASER_CONFIG=/etc/hydra-umc/bridge-laser.toml
EnvironmentFile=-/etc/hydra-umc/bridge-laser.env
ExecStartPre=/usr/bin/python3 -m hydra_umc_bridge_laser --check
ExecStart=/usr/bin/python3 -m hydra_umc_bridge_laser
Restart=on-failure
RestartSec=5
StateDirectory=hydra-umc-bridge-laser
RuntimeDirectory=hydra-umc
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# the GPIO chip and the serial port are the only devices it needs
DevicePolicy=closed
DeviceAllow=/dev/gpiochip0 rw
DeviceAllow=char-ttyUSB rw
DeviceAllow=char-ttyACM rw
MemoryAccounting=yes
MemoryHigh=128M
MemoryMax=192M

[Install]
WantedBy=multi-user.target
